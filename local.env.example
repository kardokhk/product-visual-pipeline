# Copy to local.env (gitignored) and adjust for your machine.
export PY=python                          # interpreter of the environment built from requirements.txt
export HF_HOME=$HOME/.cache/huggingface   # model weights cache
export FONTS_DIR=                         # optional: folder with NimbusSans-Regular.otf / -Bold.otf
export FFMPEG=ffmpeg                      # ffmpeg with libx264
export SLURM_ACCOUNT=                     # your Slurm account, for GPU stages
export SLURM_PARTITION=gpu
export BROWSER_PY=python                  # interpreter with playwright (PDF build only)
export BROWSER_LIBS=                      # extra shared libraries for headless Chromium, if needed
export PLAYWRIGHT_BROWSERS_PATH=
